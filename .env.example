# Required for the LLM review pass. Without it, the app runs in static-only mode.
ANTHROPIC_API_KEY=your-api-key-here

# Model used for the LLM review pass
ANTHROPIC_MODEL=claude-sonnet-4-6

# Max tokens for the LLM's response
ANTHROPIC_MAX_TOKENS=4000

# Enable/disable the LLM pass entirely (true/false). Useful for offline/CI runs.
ENABLE_LLM_REVIEW=true

# Max size (in KB) of a single file accepted for review
MAX_FILE_SIZE_KB=500

# In-memory cache TTL in seconds for identical (code, filename) submissions
CACHE_TTL_SECONDS=3600

# CORS origins allowed to hit the API (comma separated), "*" for all
CORS_ORIGINS=*
